:var(--subtle);font-size:10px;letter-spacing:.05em}.sidebar-caption{margin:67px 17px 13px;color:#657c84;font-size:10px;font-weight:800;letter-spacing:.18em}.tab-navigation{display:grid;gap:5px}.tab-btn{border:1px solid transparent;background:transparent;color:#98aab0;text-align:left;padding:12px 14px;border-radius:10px;font-weight:700;font-size:13px;display:flex;align-items:center;gap:13px;min-height:47px;transition:background .2s,color .2s}.tab-btn:hover{background:#263843;color:var(--text)}.tab-btn.active{background:#2b393e;border-color:#4c5954;color:#f5d1a4;box-shadow:inset 3px 0 0 var(--accent)}.nav-icon{display:inline-grid;place-items:center;width:20px;font-size:22px;font-weight:400;line-height:1}.sidebar-bottom{margin-top:auto}.source-mini{display:flex;gap:10px;padding:15px 12px;border:1px solid #33444b;background:#192932;border-radius:13px}.source-mini-icon{display:grid;place-items:center;border:1px solid var(--teal);color:var(--teal);flex:0 0 18px;height:18px;border-radius:50%;font-family:serif;font-size:13px;font-weight:bold}.source-mini strong{font-size:11px;display:block;margin-bottom:5px}.source-mini p{font-size:10px;line-height:1.55;color:#9bb0b2}.sidebar-credit{color:#607983;font-size:10px;margin:20px 8px 0}.workspace{min-width:0;display:flex;flex-direction:column;min-height:100vh}.app-header{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px clamp(20px,3.2vw,48px);border-bottom:1px solid var(--line);background:#101b23}.header-heading{display:flex;align-items:center;gap:15px;white-space:nowrap;font-size:12px;font-weight:700}.eyebrow{color:var(--accent);letter-spacing:.13em;font-size:10px;font-weight:800}.header-divider{height:19px;border-left:1px solid #415058}.header-controls{display:flex;align-items:center;gap:12px}.region-selector{display:flex;align-items:center;background:#1b2a34;border:1px solid #354650;border-radius:9px;padding:6px 10px 6px 13px;gap:9px;white-space:nowrap}.region-selector span{color:#8ca4a9;font-size:11px}.region-selector select{border:0;min-width:120px;background:transparent;color:var(--text);font-weight:700;outline:0;font-size:12px}.model-badge{display:flex;align-items:center;gap:8px;color:#b4cbc7;border:1px solid #315149;background:#18352f;padding:10px 12px;border-radius:9px;white-space:nowrap;font-size:11px;font-weight:700}.status-dot{width:7px;height:7px;background:#73c5a5;box-shadow:0 0 0 4px #73c5a522;border-radius:50%}.app-content{flex:1;width:min(100%,1660px);margin:0 auto;padding:37px clamp(20px,3.2vw,48px) 55px}.page-intro{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:27px}.section-kicker{display:inline-flex;align-items:center;gap:10px;color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.16em}.kicker-line{display:inline-block;width:19px;height:1px;background:var(--accent)}.page-intro h1{font-size:clamp(28px,3.3vw,43px);letter-spacing:-.05em;line-height:1.15;margin:11px 0 8px;font-weight:800}.page-intro h1 em{color:#e2a86f;font-style:normal}.page-intro p{font-size:13px;color:var(--muted);max-width:680px}.intro-note{display:flex;gap:13px;align-items:center;min-width:260px;max-width:300px;padding:13px 15px;background:#182a32;border:1px solid #315057;border-radius:12px}.intro-note-icon{color:var(--teal);font-size:23px;font-weight:500;line-height:1}.intro-note strong{font-size:11px;margin-bottom:3px;display:block}.intro-note span:last-child{font-size:10px;color:#9eb4b5;line-height:1.4;display:block}.kpi-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:20px}.history-kpis{grid-template-columns:repeat(3,1fr)}.kpi-card{position:relative;min-height:139px;background:var(--surface);border:1px solid #2d404b;border-radius:13px;padding:21px 21px 17px;overflow:hidden}.kpi-card::before{position:absolute;content:\"\";height:1px;width:42%;top:0;left:0;background:linear-gradient(90deg,var(--accent),transparent)}.kpi-icon{position:absolute;right:19px;top:18px;display:grid;place-items:center;width:27px;height:27px;border-radius:7px;background:#253b42;color:#8ec8bc;font-size:18px}.icon-alert{background:#45382e;color:#f1b57d}.icon-peak{background:#40362f;color:#e6a16e}.icon-cells{background:#28363f;color:#aac8c8}.kpi-label{color:#94aab0;font-size:11px;font-weight:700;margin-bottom:7px;padding-right:25px}.kpi-value{color:#f6f5ed;font-size:clamp(25px,2.4vw,34px);letter-spacing:-.05em;font-weight:800;line-height:1.2}.kpi-sub{color:var(--subtle);font-size:10px;margin-top:7px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:18px;align-items:start}.section-card{background:var(--surface);border:1px solid #2d404b;border-radius:14px;overflow:hidden}.card-topline{padding:20px 21px 17px;display:flex;align-items:center;justify-content:space-between;gap:15px}.card-topline h2{font-size:17px;font-weight:800;letter-spacing:-.03em;line-height:1.35;margin-top:5px}.map-live-label{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;color:#d9bb91;font-size:10px;font-weight:800;letter-spacing:.06em}.map-live-label > span{width:7px;height:7px;border-radius:50%;background:#d88746}.map-controls{display:flex;align-items:end;gap:11px;flex-wrap:wrap;padding:0 21px 19px}.map-controls label{font-size:10px;color:#93aab0;font-weight:700;display:grid;gap:5px}.input-control{border:1px solid #39505a;background:#101e28;color:var(--text);border-radius:8px;padding:10px 12px;outline:none;font-size:12px}.map-stage{position:relative;height:clamp(430px,47vw,615px);background:#0b1720;overflow:hidden}.map-stage img{width:100%;height:100%;object-cover:center;opacity:0.6}.map-overlay-label{pointer-events:none;position:absolute;z-index:500;right:18px;top:18px;display:flex;align-items:center;gap:8px;background:#101e28e8;border:1px solid #48605e;border-radius:7px;color:#e9efe8;font-size:9px;font-weight:800;letter-spacing:.13em;padding:9px 11px;backdrop-filter:blur(8px)}.map-overlay-dot{width:7px;height:7px;border-radius:50%;background:var(--accent)}.map-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:15px 20px}.legend-container{display:flex;align-items:center;flex-wrap:wrap;gap:12px}.legend-title{font-size:9px;letter-spacing:.12em;font-weight:800;color:#758f97;margin-right:1px}.legend-item{display:flex;align-items:center;gap:5px;font-size:10px;color:#bbcbca;white-space:nowrap}.legend-color{width:8px;height:8px;border-radius:2px;display:inline-block}.legend-ext{background:var(--extreme)}.legend-mod{background:var(--moderate)}.legend-unknown{background:#91a4a8}.map-hint{font-size:10px;color:var(--subtle)}.insight-card,.context-card{padding:24px 22px}.insight-card h2,.context-card h2{font-size:19px;margin:13px 0 12px;font-weight:800}.insight-card p,.context-card p{color:#9eb2b6;font-size:12px;line-height:1.7}.source-callout{display:grid;gap:7px;border:1px solid #415448;background:#23362f;border-radius:9px;padding:14px;margin-top:22px}.source-callout span{font-size:9px;color:#a7c9a9;font-weight:800;letter-spacing:.13em}.source-callout strong{font-size:12px;color:#edf2ef}.source-callout small{color:#a2bbae;font-size:10px;line-height:1.5}.app-footer{display:flex;justify-content:space-between;gap:15px;padding:15px clamp(20px,3.2vw,48px);color:#617c84;border-top:1px solid #273b44;font-size:9px;font-weight:700;letter-spacing:.04em;background:#0b141c}</style></head><body><div class=\"app-shell\" data-sd-id=\"1\"><aside class=\"sidebar\" data-sd-id=\"2\"><a class=\"brand\" href=\"#\" id=\"nav-brand\" aria-label=\"Vigía Fuego, inicio\" data-sd-id=\"3\"><span class=\"brand-mark\" data-sd-id=\"4\">♨</span><span data-sd-id=\"5\"><strong>VIGÍA<span data-sd-id=\"6\">FUEGO</span></strong><small>Inteligencia territorial</small></span></a><span class=\"sidebar-caption\" data-sd-id=\"7\">EXPLORAR</span><nav class=\"tab-navigation\" aria-label=\"Secciones\" data-sd-id=\"8\"><button class=\"tab-btn\" id=\"tab-panorama\" data-sd-id=\"9\"><span class=\"nav-icon\" data-sd-id=\"10\">◫</span> Panorama</button><button class=\"tab-btn active\" id=\"tab-history\" data-sd-id=\"11\"><span class=\"nav-icon\" data-sd-id=\"12\">◉</span> Observaciones</button><button class=\"tab-btn\" id=\"tab-analyze\" data-sd-id=\"13\"><span class=\"nav-icon\" data-sd-id=\"14\">⌖</span> Analizar un punto</button></nav><div class=\"sidebar-bottom\" data-sd-id=\"15\"><div class=\"source-mini\" data-sd-id=\"16\"><span class=\"source-mini-icon\" data-sd-id=\"17\">i</span><div data-sd-id=\"18\"><strong>Cómo leer esta plataforma</strong><p data-sd-id=\"19\">Clasificación retrospectiva de detecciones FIRMS. No es un pronóstico ni una alerta en tiempo real.</p></div></div><div class=\"sidebar-credit\" data-sd-id=\"20\">FIRMS · Open-Meteo · Modelo ML</div></div></aside><div class=\"workspace\" data-sd-id=\"21\"><header class=\"app-header\" data-sd-id=\"22\"><div class=\"header-heading\" data-sd-id=\"23\"><span class=\"eyebrow\" data-sd-id=\"24\">CENTRO DE ANÁLISIS / PERÚ</span><span class=\"header-divider\" data-sd-id=\"25\"></span><span id=\"header-section-name\" data-sd-id=\"26\">Archivo satelital</span></div><div class=\"header-controls\" data-sd-id=\"27\"><label class=\"region-selector\" for=\"region-select\" data-sd-id=\"28\"><span data-sd-id=\"29\">Región</span><select id=\"region-select\" data-sd-id=\"30\"><option data-sd-id=\"31\">Madre de Dios</option></select></label><div class=\"model-badge\" data-sd-id=\"32\"><span class=\"status-dot\" data-sd-id=\"33\"></span><span id=\"model-badge-text\" data-sd-id=\"34\">Modelo calibrado</span></div></div></header><main class=\"app-content\" data-sd-id=\"35\"><section id=\"screen-history\" class=\"screen-view active\" style=\"display:block\" data-sd-id=\"36\"><div class=\"page-intro\" data-sd-id=\"37\"><div data-sd-id=\"38\"><div class=\"section-kicker\" data-sd-id=\"39\"><span class=\"kicker-line\" data-sd-id=\"40\"></span> ARCHIVO SATELITAL</div><h1 id=\"history-title\" data-sd-id=\"41\">Huellas <em>en el archivo.</em></h1><p data-sd-id=\"42\">Consulta las detecciones incluidas en el archivo visual y filtra por sensor o confianza.</p></div><div class=\"intro-note\" data-sd-id=\"43\"><span class=\"intro-note-icon\" data-sd-id=\"44\">◎</span><div data-sd-id=\"45\"><strong>Archivo de referencia</strong><span id=\"history-range\" data-sd-id=\"46\">Enero 2024 — Diciembre 2024</span></div></div></div><div class=\"kpi-row history-kpis\" data-sd-id=\"47\"><article class=\"kpi-card\" data-sd-id=\"48\"><span class=\"kpi-icon icon-alert\" data-sd-id=\"49\">◉</span><div class=\"kpi-label\" data-sd-id=\"50\">Puntos visibles</div><div id=\"kpi-history-total\" class=\"kpi-value\" data-sd-id=\"51\">1,248</div><div class=\"kpi-sub\" data-sd-id=\"52\">Tras aplicar los filtros</div></article><article class=\"kpi-card\" data-sd-id=\"53\"><span class=\"kpi-icon icon-peak\" data-sd-id=\"54\">✦</span><div class=\"kpi-label\" data-sd-id=\"55\">Confianza alta</div><div id=\"kpi-history-high\" class=\"kpi-value\" data-sd-id=\"56\">412</div><div class=\"kpi-sub\" data-sd-id=\"57\">Entre las detecciones visibles</div></article><article class=\"kpi-card\" data-sd-id=\"58\"><span class=\"kpi-icon icon-cells\" data-sd-id=\"59\">◫</span><div class=\"kpi-label\" data-sd-id=\"60\">Fuera de Perú</div><div id=\"kpi-history-unmapped\" class=\"kpi-value\" data-sd-id=\"61\">15</div><div class=\"kpi-sub\" data-sd-id=\"62\">Puntos del archivo sin región</div></article></div><div class=\"dashboard-grid\" data-sd-id=\"63\"><div class=\"main-column\" data-sd-id=\"64\"><div class=\"section-card map-card\" data-sd-id=\"65\"><div class=\"card-topline\" data-sd-id=\"66\"><div data-sd-id=\"67\"><span class=\"section-kicker\" data-sd-id=\"68\">02 / DETECCIONES</span><h2 data-sd-id=\"69\">Puntos de referencia</h2></div><span class=\"map-live-label\" data-sd-id=\"70\"><span data-sd-id=\"71\"></span> ARCHIVO</span></div><div class=\"map-controls\" data-sd-id=\"72\"><label for=\"filter-confidence\" data-sd-id=\"73\">Confianza <select id=\"filter-confidence\" class=\"input-control\" data-sd-id=\"74\"><option value=\"all\" data-sd-id=\"75\">Todas</option><option value=\"high\" data-sd-id=\"76\">Alta</option><option value=\"nominal\" data-sd-id=\"77\">Nominal y alta</option></select></label><label for=\"filter-satellite\" data-sd-id=\"78\">Instrumento <select id=\"filter-satellite\" class=\"input-control\" data-sd-id=\"79\"><option value=\"all\" data-sd-id=\"80\">Todos</option><option value=\"VIIRS\" data-sd-id=\"81\">VIIRS</option><option value=\"MODIS\" data-sd-id=\"82\">MODIS</option></select></label></div><div class=\"map-stage\" data-sd-id=\"83\"><div class=\"map-overlay-label\" data-sd-id=\"84\"><span class=\"map-overlay-dot\" data-sd-id=\"85\"></span> DETECCIONES ARCHIVADAS</div><div class=\"w-full h-full bg-[#0b1720] flex items-center justify-center\" data-sd-id=\"86\"><div class=\"relative w-full h-full\" data-sd-id=\"87\"><div class=\"absolute inset-0 opacity-20 bg-[url('https://images.unsplash.com/photo-1518176258769-f227c798150e?auto=format&amp;fit=crop&amp;q=80&amp;w=1200')] bg-cover\" data-sd-id=\"88\"></div><div class=\"absolute left-1/2 top-1/2 w-4 h-4 rounded-full bg-orange-500 blur-sm animate-pulse\" data-sd-id=\"89\"></div><div class=\"absolute left-[45%] top-[40%] w-3 h-3 rounded-full bg-orange-400 opacity-80\" data-sd-id=\"90\"></div><div class=\"absolute left-[52%] top-[55%] w-3 h-3 rounded-full bg-orange-600 opacity-90\" data-sd-id=\"91\"></div><div class=\"absolute left-[58%] top-[48%] w-2 h-2 rounded-full bg-white opacity-50\" data-sd-id=\"92\"></div></div></div></div><div class=\"map-footer\" data-sd-id=\"93\"><div class=\"legend-container\" data-sd-id=\"94\"><span class=\"legend-title\" data-sd-id=\"95\">CONFIANZA</span><span class=\"legend-item\" data-sd-id=\"96\"><i class=\"legend-color legend-ext\"></i> Alta</span><span class=\"legend-item\" data-sd-id=\"97\"><i class=\"legend-color legend-mod\"></i> Nominal</span><span class=\"legend-item\" data-sd-id=\"98\"><i class=\"legend-color legend-unknown\"></i> Baja</span></div><span class=\"map-hint\" data-sd-id=\"99\">Selecciona un punto para ver sus datos</span></div></div></div><aside class=\"insight-column\" data-sd-id=\"100\"><div class=\"section-card insight-card\" data-sd-id=\"101\"><span class=\"section-kicker\" data-sd-id=\"102\">EN CONTEXTO</span><h2 data-sd-id=\"103\">Un punto térmico no confirma un incendio</h2><p data-sd-id=\"104\">Los sensores detectan anomalías térmicas. La confianza y la potencia radiativa ayudan a interpretar cada observación; la ausencia de un punto tampoco confirma ausencia de fuego.</p><div class=\"source-callout\" data-sd-id=\"105\"><span data-sd-id=\"106\">FUENTE VISUAL</span><strong>Muestra local con formato FIRMS</strong><small>El archivo local no incluye comprobantes de descarga por punto. Úsalo como referencia visual, no como registro oficial completo.</small></div></div><div class=\"section-card context-card\" data-sd-id=\"107\"><span class=\"section-kicker\" data-sd-id=\"108\">FILTROS ACTIVOS</span><h2 data-sd-id=\"109\">Lectura del archivo</h2><p id=\"history-summary\" data-sd-id=\"110\">Mostrando detecciones registradas en Madre de Dios para el año seleccionado. Use los filtros superiores para refinar la precisión de los puntos mostrados en el mapa.</p></div></aside></div></section></main><footer class=\"app-footer\" data-sd-id=\"111\"><span data-sd-id=\"112\">VIGÍA FUEGO · EXPLORADOR RETROSPECTIVO</span><span data-sd-id=\"113\">Datos: FIRMS y Open-Meteo · Límites: geoBoundaries · No apto para alertas operativas</span></footer></div></div></body></html>",
