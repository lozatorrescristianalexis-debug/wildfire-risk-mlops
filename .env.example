# FIRMS API key (copy this file to .env and add your key locally).
MAP_KEY=

# Región seleccionada: 'madre_de_dios' o 'peru' (por defecto: madre_de_dios)
REGION=madre_de_dios

# Configuración por defecto (Madre de Dios):
FIRMS_AREA=-72.4287387,-13.3413977,-68.6519906,-9.9069082
METEO_LATITUDE=-12.0
METEO_LONGITUDE=-70.25
GRID_CELL_DEGREES=0.25

# Para todo el Perú (descomentar o usar REGION=peru):
# REGION=peru
# FIRMS_AREA=-81.33,-18.35,-68.65,-0.038
# METEO_LATITUDE=-9.19
# METEO_LONGITUDE=-75.015
# GRID_CELL_DEGREES=0.5

# Optimización de consultas Open-Meteo (lotes de coordenadas y bloques de días):
WEATHER_BATCH_SIZE=100
WEATHER_CHUNK_DAYS=180

FIRMS_SOURCE=VIIRS_SNPP_SP
START_DATE=2024-10-10
END_DATE=2026-10-10

# Optional map observations snapshot. Default: bundled web/fire_observations.json.gz.
# WILDFIRE_OBSERVATIONS_PATH=/absolute/path/to/fire_observations.json.gz
# MAP_KEY is optional for the observation worker: official rolling CSV is its fallback.
